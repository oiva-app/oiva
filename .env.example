# Environment: "development" or "production".
# Unset defaults to "production" (fail-closed). When production, HC_SHARED_SECRET is REQUIRED.
NODE_ENV=development

# ***********************************************************************************
# name of the observed app
OBSERVED_APP_NAME=

# ***********************************************************************************
# agent
OPENAI_API_KEY=

# ***********************************************************************************
# MCP KEY, aka Agent API KEY should have:
#     Environments: minimum Read-only
#     MCP: minimum read-only
# This key is created at the Team level and NOT as the Environment level
# FORMAT: key_id:key_secret
# EXAMPLE: iw83o:kdo93
# More info: https://docs.honeycomb.io/integrations/mcp/configuration-guide
HC_MCP_KEY=

# Honeycomb webhook shared secret. HC sends it as the X-Honeycomb-Webhook-Token header.
# Optional in development (webhooks run unauthenticated). REQUIRED when 
# NODE_ENV=production.
HC_SHARED_SECRET=

# ***********************************************************************************
# GitHub PAT -- only for oiva-app/3-services-demo (read-only)
GITHUB_PAT=
APP_GITHUB_HTTPS_URL=

# max step configs for agent loops
# WARNING: lower values increase likelihood that subagent will return empty text output
SUPERVISOR_MAX_STEPS=
SUBAGENT_MAX_STEPS=
TELEMETRY_MAX_STEPS=
CODEBASE_MAX_STEPS=
# Set to false to skip evals and save tokens (default: true)
RUN_EVALS=true

# ***********************************************************************************
# otel-collector
COLLECTOR_ENDPOINT=http://localhost:4318/v1/traces

# this is an Environment-specific ingest-only key
HONEYCOMB_API_KEY=
CORS_ALLOWED_ORIGIN=""  # TODO

#*************************************************************************************
# AWS
AWS_PROFILE=
KNOWLEDGE_BASE_S3_BUCKET=
# use an empty string "" for KNOWLEDGE_BASE_S3_PREFIX if no prefix
KNOWLEDGE_BASE_S3_PREFIX=
AWS_REGION=

# ***********************************************************************************
# Slack

SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=

# ***********************************************************************************

# postgres (compose service: postgres)
# DATABASE_URL is intentionally unsupported; use these split variables.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=oiva
POSTGRES_PASSWORD=oiva_dev
POSTGRES_DB=oiva

# Optional migration runner overrides.
# MIGRATIONS_DIR defaults to src/mastra/db/migrations.
MIGRATIONS_DIR=
# Number of DB connection attempts for migrations (default: 10).
MIGRATE_CONNECT_MAX_ATTEMPTS=10

# ***********************************************************************************

# Correlation time window in minutes (default: 30). Alerts within this
# window matching an existing incident's (trigger, dataset, query) tuple
# attach to that incident. Outside the window → new incident.
CORRELATION_WINDOW_MINUTES=30

# Cleanup reaper thresholds (minutes). See services/reaper.ts.
REAPER_DELIVERED_QUIET_MINUTES=
REAPER_FAILED_QUIET_MINUTES= # 24h — keep the Retry button around for a day
REAPER_STUCK_DEADLINE_MINUTES=  # MUST exceed the slowest investigation (sweep 3 kills live-but-slow runs)
REAPER_ENABLED=false
REAPER_INTERVAL_MINUTES=10
